    >
      Claim & Burn
    </h2>
    <div
      aria-label="Select mode"
      class="dark:bg-slate-800 mb-5 flex rounded-lg bg-slate-100 p-1"
      role="group"
    >
      <button
        aria-label="Switch to claim mode"
        aria-pressed="true"
        class="toggle-btn active focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
        data-testid="toggle-claim"
        type="button"
      >
        Claim
      </button>
      <button
        aria-label="Switch to burn mode"
        aria-pressed="false"
        class="toggle-btn focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
        data-testid="toggle-burn"
        type="button"
      >
        Burn
      </button>
    </div>
    <form
      aria-label="Claim tokens"
      data-testid="claim-burn-form"
    >
      <div
        class="mb-1 flex flex-col gap-1.5"
      >
        <label
          class="dark:text-slate-300 text-sm font-medium text-slate-700"
          for="amount-input"
        >
          Amount (
          XLM
          )
        </label>
        <div
          class="flex gap-2"
        >
          <input
            aria-invalid="false"
            aria-label="Claim amount"
            class="focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
            data-testid="amount-input"
            id="amount-input"
            inputmode="decimal"
            pattern="^[0-9]*(?:[.,][0-9]*)?$"
            placeholder="0.00"
            type="text"
            value=""
          />
        </div>
      </div>
      <button
        aria-busy="false"
        aria-label="Claim tokens"
        class="btn btn-claim focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
        data-testid="submit-btn"
        disabled=""
        type="submit"
      >
        Claim
      </button>
    </form>
    <div
      aria-atomic="true"
      aria-live="polite"
      class="rounded-lg p-3 text-sm font-medium transition-all duration-200 overflow-hidden hidden mt-4"
      data-testid="claim-burn-status"
      role="status"
    />
  </div>
  <div
    aria-atomic="true"
    aria-live="polite"
    class="toast-portal"
  />
</div>
`;

