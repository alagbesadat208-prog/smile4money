exports[`CreateMatch — snapshots > matches snapshot: Chess.com platform selected 1`] = `
<div>
  <div
    class="create-match"
    data-testid="create-match"
  >
    <h2
      class="create-match-title"
    >
      Create New Match
    </h2>
    <aside
      aria-label="Wagering eligibility"
      class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100"
      data-testid="eligibility-notice"
      role="note"
    >
      <p>
        <strong>
          Real-money wagering is restricted.
        </strong>
         It is only for people aged 
        18
        + (or older where local law requires) who are located in a jurisdiction where it is legal and that this service supports.
         
        This deployment has not published a list of supported jurisdictions, so do not wager real funds.
         
        You are responsible for checking that wagering is legal where you are.
      </p>
      <p
        class="mt-1"
      >
        You are on a test network: stakes use test tokens with no real value.
      </p>
    </aside>
    <form
      data-testid="create-match-form"
      novalidate=""
    >
      <div
        class="form-group"
      >
        <label>
          Stake Token
        </label>
        <div
          aria-label="Select token"
          class="token-toggle"
          role="group"
        >
          <button
            aria-pressed="true"
            class="toggle-btn active"
            data-testid="toggle-xlm"
            type="button"
          >
            XLM
          </button>
          <button
            aria-pressed="false"
            class="toggle-btn"
            data-testid="toggle-usdc"
            type="button"
          >
            USDC
          </button>
        </div>
      </div>
      <div
        class="form-group"
      >
        <label
          for="player2-address"
        >
          Player 2 Address
        </label>
        <input
          aria-invalid="false"
          data-testid="player2-input"
          id="player2-address"
          placeholder="G..."
          type="text"
          value=""
        />
      </div>
      <div
        class="form-group"
      >
        <label
          for="stake-amount"
        >
          Stake Amount (XLM)
        </label>
        <input
          aria-invalid="false"
          data-testid="stake-amount-input"
          id="stake-amount"
          inputmode="decimal"
          placeholder="e.g. 1.5 (converts to 15,000,000 stroops)"
          type="text"
          value=""
        />
      </div>
      <div
        class="form-group"
      >
        <label
          for="game-id"
        >
          Game ID
        </label>
        <input
          aria-invalid="false"
          data-testid="game-id-input"
          id="game-id"
          placeholder="Enter game ID from platform"
          type="text"
          value=""
        />
      </div>
      <div
        class="form-group"
      >
        <label>
          Platform
        </label>
        <div
          aria-label="Select platform"
          class="platform-selector"
          role="group"
        >
          <button
            aria-pressed="true"
            class="platform-btn active"
            data-testid="platform-lichess"
            type="button"
          >
            Lichess
          </button>
          <button
            aria-pressed="false"
            class="platform-btn"
            data-testid="platform-chesscom"
            type="button"
          >
            Chess.com
          </button>
        </div>
      </div>
      <button
        aria-busy="false"
        class="btn btn-submit"
        data-testid="submit-match-btn"
        type="submit"
      >
        Create Match
      </button>
    </form>
  </div>
</div>
`;

